# ─── Required for Authentication & Database ───
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# ─── Production Persistent Database (Recommended for Reflex Cloud / Containers) ───
# If set, FraudRadar automatically persists users, OTPs, and audit logs to Supabase PostgreSQL.
# SQLite in local data/auth.db is used as fallback when DATABASE_URL is not set.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── App Base URL & Cryptographic Security ───
APP_BASE_URL=https://your-production-domain.com
JWT_SECRET=your_jwt_secret_key_for_session_tokens_256bit_hex

# ─── Unified Email Delivery Configuration (Required for Live OTP Emails) ───
# Standard SMTP configuration (Works with Gmail App Passwords, Brevo, SendGrid, Amazon SES, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=FraudRadar Scam Defense

# Alternative Transactional Email APIs (Optional)
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_123456789
# SENDGRID_API_KEY=SG.123456789

# Development & Testing Mode (Set to true to log emails to local outbox without contacting SMTP servers)
# Set to false once real email credentials above are provided
EMAIL_DEV_MODE=false

# ─── Required for AI Analysis ───
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# ─── External Threat Intelligence APIs (Optional but recommended) ───
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=

# ─── Required for Authentication ───
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
APP_BASE_URL=https://your-production-domain.com

# ─── Required for AI Analysis ───
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# ─── External Threat Intelligence APIs (optional but recommended) ───
# Google Safe Browsing — https://console.cloud.google.com/ → Enable Safe Browsing API
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal — https://www.virustotal.com/ → Sign up → API key in profile
VIRUSTOTAL_API_KEY=

# PhishTank — https://phishtank.org/ → Register → API key
PHISHTANK_API_KEY=
